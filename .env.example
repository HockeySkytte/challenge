# Password for the pages.
#
# Leave this UNSET and the app stays locked - it does not fall back to a default
# password.  Rotating it invalidates every unlock cookie already handed out,
# because the password is part of what gets signed.
APP_PASSWORD=

# Signs the unlock cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# If unset, a random key is generated at boot: the app still works, but unlock
# cookies stop being valid after every restart.
SECRET_KEY=

# ── Optional overrides ──
# The raw file offered as a download, the cleaned file the app reads (both
# written by clean_data.py), the rink zone geometry and the xG model record.
# DATA_DIR=
# RAW_CSV=
# EVENTS_CSV=
# ZONES_GEOJSON=
# MODELS_JSON=

# Local dev only; Railway injects PORT itself.
# PORT=5002
